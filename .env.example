# Environment Variables Template
# Copy this file to .env for local development
# For deployment, set these in your hosting platform's environment variables

# Hugging Face API Token (primary AI service - free tier available)
HUGGINGFACE_API_TOKEN=your_api_key_here


# OpenAI API Key (backup option - costs per usage)
OPENAI_API_KEY=your_openai_api_key_here
